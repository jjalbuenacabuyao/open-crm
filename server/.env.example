# Copy to .env and fill in. Nothing in this file is read from a committed
# source — server/.env is git-ignored.

# --- Server ---
# The port this API listens on. The client dev server (http://localhost:3000)
# calls it directly; there is no dev proxy in front of it.
APP_PORT=8080

# Comma-separated browser origins allowed to call this API. Required in
# development too: the client is served from its own origin, so every request
# is cross-origin and a missing entry fails as an opaque browser network error.
CORS_ORIGINS=http://localhost:3000

# --- Postgres ---
# Set every one of these explicitly. The in-code fallbacks for HOST and SSLMODE
# are "loaclhost" and "disabled" — both typos, both fail to connect.
HOST=localhost
DB_USER=postgres
PASSWORD=postgres
DBNAME=open-crm
DB_PORT=5432
SSLMODE=disable
TIMEZONE=UTC

# --- Supabase ---
# Dashboard -> Project Settings -> Data API -> Project URL.
# The JWKS URL and issuer are derived from this.
#
# IMPORTANT: the project must use asymmetric (ES256 / ECC P-256) JWT signing
# keys. middleware.SupabaseAuth rejects the legacy HS256 shared secret, so a
# project that has not been migrated will 401 on every authenticated request.
# Migrate at Project Settings -> JWT Keys.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co

# Optional. Derived from SUPABASE_PROJECT_URL when left blank; set these only
# for self-hosted Supabase or a local `supabase start` (http://127.0.0.1:54321).
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
