# Copy to .env and fill in. Every value here is compiled into the browser
# bundle and is readable by anyone who loads the page, so only ever put public
# keys in this file — never a Supabase service_role key.

# Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard -> Project Settings -> API Keys -> anon / publishable key.
# This key is designed to be public; row level security is what protects data.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the Go API lives. LEAVE THIS BLANK for development: the app then issues
# relative /api/v1 requests, which `ng serve` proxies to the Go server (see
# proxy.conf.json). Everything the browser touches is then http://localhost:4200,
# same origin, so CORS never comes into play locally.
#
# Set an absolute URL only when the API is on a different origin than the app —
# in which case it must also appear in CORS_ORIGINS in server/.env.
API_BASE_URL=
