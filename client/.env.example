# Copy to .env and fill in. Vite inlines every VITE_ variable into the browser
# bundle, so anyone who loads the page can read these — only ever put public
# keys in this file, never a Supabase service_role key.

# Dashboard -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard -> Project Settings -> API Keys -> anon / publishable key.
# This key is designed to be public; row level security is what protects data.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the Go API lives. Defaults to http://localhost:8080 when unset, which is
# what server/.env uses. There is no dev proxy, so this is a cross-origin URL and
# whatever origin serves this app has to appear in CORS_ORIGINS in server/.env.
VITE_API_BASE_URL=
